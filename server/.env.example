NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
# Create a fresh PostgreSQL database and set its connection URL here
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/innovel_lms
PGSSL=false
JWT_ACCESS_SECRET=REPLACE_WITH_A_RANDOM_64_CHARACTER_SECRET
JWT_ACCESS_TTL=15m
BCRYPT_ROUNDS=12
ADMIN_NAME=INNOVEL Admin
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=REPLACE_WITH_YOUR_16_CHARACTER_ADMIN_PASSWORD
INSTRUCTOR_EMAIL=Instructor@gmail.com
INSTRUCTOR_PASSWORD=REPLACE_WITH_YOUR_16_CHARACTER_INSTRUCTOR_PASSWORD
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME
ZOOM_ACCOUNT_ID=REPLACE_ME
ZOOM_CLIENT_ID=REPLACE_ME
ZOOM_CLIENT_SECRET=REPLACE_ME
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=YOUR_GMAIL@gmail.com
SMTP_PASS=YOUR_16_CHARACTER_GOOGLE_APP_PASSWORD
EMAIL_FROM=INNOVEL Learning <YOUR_GMAIL@gmail.com>
OTP_TTL_MINUTES=10
